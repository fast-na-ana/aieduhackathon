# training outputs
runs/
out/
outputs/
results/
logs/

# model weights are downloaded or trained, never committed (big, and some are non-commercial licensed)
# exception: the small exported pulse model, which the demo laptop needs
*.pt
*.pth
*.h5
*.ckpt
*.pkl
*.joblib
models/weights/
*.onnx
!pulse_model/export/*.onnx
*.task

# demo app: downloaded models, the SAMPLE ID photo and session logs stay local
demo_app/models/
demo_app/assets/
demo_app/logs/

# node (not used yet)
node_modules/
.next/

# editors, OS and tool state
.vscode/
