*.mp4
*.avi
*.mov
*.mkv
*.webm
*.gif
*.jpg
*.jpeg
*.png
!docs/**/*.png

# secrets
.env
.env.*
!.env.example
*.key

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
